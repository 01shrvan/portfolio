---
interface Props {
  text: string;
  source: string;
}

const { text, source } = Astro.props;
---

{/* Dashed rules top and bottom so it reads as a pulled-aside panel rather
    than another section of the document. The quote mark is decoration and
    is hidden from screen readers — the quotation marks in the text carry
    the meaning. */}
<figure class="relative overflow-hidden border-y border-dashed bg-surface/60 px-6 py-7 sm:px-9">
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-8 left-2 select-none font-mono text-[8rem] leading-none text-ink/[0.06] sm:text-[10rem]"
  >
    &ldquo;
  </span>

  <blockquote class="relative">
    <p class="data max-w-[62ch] text-[0.72rem] italic leading-[1.85] text-ink-soft sm:text-[0.78rem]">
      &ldquo;{text}&rdquo;
    </p>
    <figcaption class="data mt-3 text-right italic text-ink-soft">
      &mdash; {source}
    </figcaption>
  </blockquote>
</figure>
