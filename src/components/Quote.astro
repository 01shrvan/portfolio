---
import { QUOTES, quoteForDay } from "@/lib/quotes";

const quote = quoteForDay();
---

<figure
  data-quote
  class="relative overflow-hidden border-y border-dashed bg-surface/60 px-6 py-7 sm:px-9"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-8 left-2 select-none font-mono text-[8rem] leading-none text-ink/[0.06] sm:text-[10rem]"
  >
    &ldquo;
  </span>

  <blockquote class="relative">
    <p
      data-quote-text
      class="data max-w-[62ch] text-[0.72rem] italic leading-[1.85] text-ink-soft sm:text-[0.78rem]"
    >
      &ldquo;{quote.text}&rdquo;
    </p>
    <figcaption class="data mt-3 text-right italic text-ink-soft">
      &mdash; <span data-quote-source>{quote.source}</span>
    </figcaption>
  </blockquote>
</figure>

<script is:inline define:vars={{ pool: QUOTES }}>
  (() => {
    const root = document.querySelector("[data-quote]");
    if (!root || !Array.isArray(pool) || pool.length === 0) return;

    const now = new Date();
    const day = Math.floor(
      Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86400000,
    );
    const quote = pool[day % pool.length];

    const text = root.querySelector("[data-quote-text]");
    const source = root.querySelector("[data-quote-source]");
    if (text) text.textContent = `“${quote.text}”`;
    if (source) source.textContent = quote.source;
  })();
</script>
