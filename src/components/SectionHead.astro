---
interface Props {
  label: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { label, title, href, linkLabel = "View all" } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
  <div>
    <p class="mono text-accent">{label}</p>
    <h2 class="display mt-2.5 text-step-3">{title}</h2>
  </div>

  {
    href && (
      <a
        href={href}
        class="pill group text-step--1 transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        {linkLabel}
        <svg
          class="size-3.5 transition-transform duration-200 ease-out-quint group-hover:translate-x-0.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    )
  }
</div>
