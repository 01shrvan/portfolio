---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"works">;
  /** The first card runs full width; the rest pair up. */
  wide?: boolean;
}

const { entry, wide = false } = Astro.props;
const { title, description, role, href, date } = entry.data;
const year = date.getFullYear();
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "pane group relative flex flex-col justify-between gap-8 p-6 transition-all duration-300 ease-out-quint hover:-translate-y-1 hover:border-accent/45 sm:p-7",
    wide ? "md:col-span-2 md:flex-row md:items-end md:gap-12" : "",
  ]}
>
  <div class={wide ? "md:max-w-xl" : ""}>
    <div class="flex items-center gap-3">
      <span class="mono text-fg-2">{year}</span>
      <span class="h-px flex-1 bg-line"></span>
    </div>

    <h3
      class:list={[
        "display mt-4 transition-colors duration-200 group-hover:text-accent",
        wide ? "text-step-3" : "text-step-2",
      ]}
    >
      {title}
    </h3>

    <p class="mt-3 max-w-prose text-step--1 leading-relaxed text-fg-2">
      {description}
    </p>
  </div>

  <div class="flex items-center justify-between gap-4">
    <span class="pill mono shrink-0 text-fg-2">{role}</span>
    <span
      class="grid size-9 shrink-0 place-items-center rounded-full border border-line text-fg-2 transition-all duration-200 ease-out-quint group-hover:border-accent group-hover:bg-accent group-hover:text-bg"
      aria-hidden="true"
    >
      <svg
        class="size-4 transition-transform duration-200 ease-out-quint group-hover:-translate-y-px group-hover:translate-x-px"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M7 17 17 7M8 7h9v9"></path>
      </svg>
    </span>
  </div>
</a>
