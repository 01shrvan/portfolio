---
import * as si from "simple-icons";
import { STACK } from "@/lib/site";

/* Logos are inlined from simple-icons at build time — no network requests,
   no icon font, and they inherit currentColor so they follow the theme
   instead of glowing at their brand colour on a warm ground. */
function iconPath(slug: string | undefined): string | null {
  if (!slug) return null;
  const key = `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}`;
  const icon = (si as Record<string, { path?: string } | undefined>)[key];
  return icon?.path ?? null;
}
---

<dl class="grid gap-x-4 gap-y-3 sm:grid-cols-[7rem_1fr]">
  {
    STACK.map(({ layer, tools }) => (
      <div class="contents">
        <dt class="data pt-[0.35em] uppercase text-ink-soft">{layer}</dt>
        <dd class="flex flex-wrap gap-x-2 gap-y-2">
          {tools.map((tool) => {
            const path = iconPath(tool.icon);
            return (
              <a
                href={tool.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-1.5 border px-2 py-1 text-step--1 transition-colors duration-200 hover:border-filament hover:text-filament"
              >
                {path && (
                  <svg
                    class="size-3 shrink-0 text-ink-soft transition-colors duration-200 group-hover:text-filament"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={path} />
                  </svg>
                )}
                {tool.name}
              </a>
            );
          })}
        </dd>
      </div>
    ))
  }
</dl>
