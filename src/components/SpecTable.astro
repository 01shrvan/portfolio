---
interface Props {
  rows: { label: string; value: string; live?: boolean }[];
}
const { rows } = Astro.props;
---

{/* A compact table of facts — faster to read than a paragraph, and it
    gives the page a second texture next to the prose. */}
<dl class="grid grid-cols-[5.5rem_1fr] gap-x-4 gap-y-2 sm:grid-cols-[7rem_1fr]">
  {
    rows.map(({ label, value, live }) => (
      <div class="contents">
        <dt class="data pt-[0.3em] uppercase text-ink-soft">{label}</dt>
        <dd class="flex items-center gap-2 text-step--1">
          {live && (
            <span class="relative flex size-1.5 shrink-0">
              <span class="anim-mark absolute inline-flex size-full rounded-full bg-filament" />
              <span class="relative inline-flex size-1.5 rounded-full bg-filament" />
            </span>
          )}
          {value}
        </dd>
      </div>
    ))
  }
</dl>
