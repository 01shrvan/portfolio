---
import { SITE } from "@/lib/site";
const { discordId } = SITE;
---

{
  discordId && (
    <div data-now data-discord={discordId} hidden class="contents">
      <dt class="data pt-[0.3em] uppercase text-ink-soft">listening</dt>
      <dd class="flex items-baseline gap-2 text-step--1">
        <span class="relative flex size-1.5 shrink-0 translate-y-[-0.15em]">
          <span class="anim-mark absolute inline-flex size-full rounded-full bg-filament" />
          <span class="relative inline-flex size-1.5 rounded-full bg-filament" />
        </span>
        <span class="min-w-0">
          <a
            data-now-link
            class="text-ink transition-colors duration-200 hover:text-filament"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span data-now-track />
          </a>
          <span class="text-ink-soft"> &middot; <span data-now-artist /></span>
        </span>
      </dd>
    </div>
  )
}

<script>
  const render = async () => {
    const el = document.querySelector<HTMLElement>("[data-now]");
    if (!el) return;

    const id = el.dataset.discord;
    if (!id) return;

    try {
      const res = await fetch(`https://api.lanyard.rest/v1/users/${id}`);
      if (!res.ok) return;

      const { data } = await res.json();
      const song = data?.spotify;
      if (!song?.song) {
        el.hidden = true;
        return;
      }

      const track = el.querySelector("[data-now-track]");
      const artist = el.querySelector("[data-now-artist]");
      const link = el.querySelector<HTMLAnchorElement>("[data-now-link]");
      if (!track || !artist || !link) return;

      track.textContent = song.song.toLowerCase();
      artist.textContent = song.artist.split(";")[0].trim().toLowerCase();
      link.href = `https://open.spotify.com/track/${song.track_id}`;
      el.hidden = false;
    } catch {
      el.hidden = true;
    }
  };

  render();
  setInterval(render, 30000);
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) render();
  });
</script>
