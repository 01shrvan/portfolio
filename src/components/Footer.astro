---
import Link from "./Link.astro";
import Timer from "./Timer";

const socials = [
  { href: "https://twitter.com/01shrvan", label: "twitter" },
  { href: "https://github.com/01shrvan", label: "github" },
  { href: "mailto:benkeshrvan@gmail.com", label: "email" },
];
---

<footer class="py-2.5 border-t">
  <div class="px-2.5 py-6">
    <div class="space-y-8">
      <div class="flex flex-wrap items-center">
        {
          socials.map((social, index) => (
            <li class="flex items-center">
              <Link className="md:text-base" blank={true} href={social.href}>
                {social.label}
              </Link>
              {index != socials.length - 1 && (
                <span aria-hidden="true" class="select-none px-2">
                  •
                </span>
              )}
            </li>
          ))
        }
      </div>
      <div
        class="flex flex-col gap-2 md:flex-row md:justify-between md:items-center"
      >
        <Timer client:only="react" />
      </div>
    </div>
  </div>
</footer>
