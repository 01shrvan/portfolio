---
const socials = [
  { href: "https://twitter.com/01shrvan", label: "twitter" },
  { href: "https://github.com/01shrvan", label: "github" },
  { href: "mailto:benkeshrvan@gmail.com", label: "email" },
];
---

<footer class="relative px-5 py-4 flex items-center justify-between">
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-screen border-t border-border pointer-events-none"
  >
  </div>

  <div
    class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 size-2 rounded-full border border-border bg-background z-10"
  >
  </div>
  <div
    class="absolute top-0 right-0 translate-x-1/2 -translate-y-1/2 size-2 rounded-full border border-border bg-background z-10"
  >
  </div>

  <div class="flex items-center gap-4">
    {
      socials.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground/60 hover:text-foreground transition-colors duration-200"
        >
          {s.label}
        </a>
      ))
    }
  </div>

  <span class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground/50">
    © 2026
  </span>
</footer>
