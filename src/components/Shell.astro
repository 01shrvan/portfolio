---
import { NAV, SITE } from "@/lib/site";
import ThemeToggle from "@/components/ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);

const timeFmt = new Intl.DateTimeFormat("en-GB", {
  timeZone: "Asia/Kolkata",
  hour: "2-digit",
  minute: "2-digit",
  second: "2-digit",
  hour12: false,
});
const initialTime = timeFmt.format(new Date());
---

<div class="flex min-h-dvh flex-col overflow-x-clip">
  <div class="mx-auto flex w-full max-w-sheet flex-1 flex-col border-x">
    <header class="sticky top-0 z-20 border-b bg-ground/92 backdrop-blur-md">
      <div class="relative flex h-12 items-center justify-between gap-3 px-gutter">
        <a
          href="/"
          class="shrink-0 text-step--1 font-medium transition-colors duration-200 hover:text-filament"
        >
          {SITE.aka}
        </a>

        <nav class="flex min-w-0 items-center gap-2.5 sm:gap-5" aria-label="Primary">
          {
            NAV.map(({ href, label }) => (
              <a
                href={href}
                aria-current={isActive(href) ? "page" : undefined}
                class:list={[
                  "text-step--1 transition-colors duration-200",
                  isActive(href)
                    ? "text-filament"
                    : "text-ink-soft hover:text-ink",
                ]}
              >
                {label}
              </a>
            ))
          }
          <ThemeToggle />
        </nav>

        <span class="reg-mark bottom-0 left-0"></span>
        <span class="reg-mark bottom-0 left-full"></span>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t px-gutter py-5">
      <div class="data flex items-center justify-between gap-4 lowercase text-ink-soft">
        <span class="shrink-0 text-ink">@{SITE.aka}</span>
        <span class="truncate">{SITE.location}</span>
        <span class="shrink-0">
          <time data-clock class="text-ink">{initialTime}</time> ist
        </span>
        <span class="shrink-0">© {new Date().getFullYear()}</span>
      </div>
    </footer>
  </div>
</div>

<script is:inline>
  (() => {
    const el = document.querySelector("[data-clock]");
    if (!el) return;

    const fmt = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Kolkata",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });
    const tick = () => {
      el.textContent = fmt.format(new Date());
    };

    tick();
    setTimeout(() => {
      tick();
      setInterval(tick, 1000);
    }, 1000 - (Date.now() % 1000));

    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) tick();
    });
  })();
</script>
