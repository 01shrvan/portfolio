---
import "@/styles/global.css";
import { ViewTransitions } from "astro:transitions";
import { Toaster } from "@/components/ui/toaster";
import Navbar from "@/components/Navbar";
import Footer from "@/components/Footer.astro";
import SpotifyNowPlaying from "@/components/SpotifyNowPlaying";

interface Props {
  title?: string;
  description?: string;
  noscroll?: boolean;
}

const {
  title = "shrvan benke — building things for the web.",
  description = "full-stack developer building clean, fast web experiences. into next.js, ai tooling, and getting the details right.",
  noscroll = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const url = Astro.url;
const isHomePage = pathname === "/";

const ogTitle = isHomePage ? "building things for the web." : title.split(" | ")[0];
const ogUrl = new URL(`/og.png?title=${encodeURIComponent(ogTitle)}`, url);
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Shrvan Benke" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={url} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="shrvan" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@01shrvan" />
    <meta name="twitter:creator" content="@01shrvan" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.png" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <ViewTransitions />
  </head>
  <body class="h-full overflow-hidden">
    <div
      class="h-full mx-auto max-w-4xl border-x border-border relative flex flex-col overflow-hidden"
    >
      <div
        class="absolute inset-0 pointer-events-none select-none"
        aria-hidden="true"
      >
        <div class="absolute inset-y-0 left-1/4 border-l border-border/[0.06]"></div>
        <div class="absolute inset-y-0 left-2/4 border-l border-border/[0.06]"></div>
        <div class="absolute inset-y-0 left-3/4 border-l border-border/[0.06]"></div>
      </div>

      <Navbar pathname={pathname} client:load />

      <main
        class:list={[
          "flex-1 relative z-10 min-h-0",
          noscroll ? "overflow-hidden" : "overflow-y-auto",
        ]}
      >
        <slot />
      </main>

      <Footer />
    </div>

    <!-- {
      isHomePage && (
        <div class="fixed bottom-4 right-2 sm:right-4 z-50 w-60 sm:w-64">
          <!-- <SpotifyNowPlaying client:load /> -->
        <!-- </div> -->
      )
    } -->

    <Toaster client:load />
  </body>
</html>
