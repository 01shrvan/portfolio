---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Shell from "@/components/Shell.astro";
import RuledHeading from "@/components/RuledHeading.astro";
import EntryRow from "@/components/EntryRow.astro";
import SpecTable from "@/components/SpecTable.astro";
import StackList from "@/components/StackList.astro";
import Figure from "@/components/Figure.tsx";
import { SITE, EXPERIENCE } from "@/lib/site";

const works = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);

const writings = (await getCollection("writings"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const monthYear = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
});
---

<Base>
  <Shell>
    <section class="px-gutter pt-12">
      <div class="flex items-start justify-between gap-6">
        <div class="anim-lift min-w-0">
          <h1 class="display text-display">{SITE.name}</h1>
          <p class="mt-0.5 text-step-0 text-ink-soft">
            {SITE.role} &middot; goes by <span class="text-ink">{SITE.aka}</span>
          </p>
        </div>

        {/* The one bit of craft on the page, kept to the size of a postage
            stamp: a live halftone render rather than an image, sitting
            beside the text at reading scale. */}
        <figure class="hidden shrink-0 sm:block">
          <div class="size-[92px] overflow-hidden border">
            <Figure client:visible />
          </div>
          <figcaption class="data mt-1.5 uppercase text-ink-soft">
            Fig. 1
          </figcaption>
        </figure>
      </div>

      <div class="anim-lift mt-7 max-w-measure space-y-3.5 [animation-delay:120ms]">
        <p>
          i&rsquo;m shrvan &mdash; a full-stack engineer in mumbai who mostly
          lives on the front end. i build web apps end to end and care a lot
          more about how they feel than how clever the backend is.
        </p>
        <p>
          most of my time goes into interfaces: next.js and react, typescript
          everywhere, tailwind for the layer people actually touch. i&rsquo;ve
          shipped a web builder platform at ayritech, campaign sites at
          dreamskrin, and a pile of my own stuff &mdash; a matchmaking app for
          gen z, a cli that hunts dead dependencies, a tool that chases your
          freelance invoices. reach me at{" "}
          <a href={`mailto:${SITE.email}`} class="link">{SITE.email}</a>.
        </p>
      </div>
    </section>

    <section class="px-gutter pt-12">
      <RuledHeading>Currently</RuledHeading>
      <div class="mt-4">
        <SpecTable
          rows={[
            {
              label: "Status",
              value: "open to freelance, contract, and full-time",
              live: true,
            },
            { label: "Based", value: `${SITE.location} — IST (UTC+5:30)` },
            { label: "Focus", value: SITE.focus },
          ]}
        />
      </div>
    </section>

    <section class="px-gutter pt-12">
      <RuledHeading count={EXPERIENCE.length}>Experience</RuledHeading>
      <div class="mt-2">
        {
          EXPERIENCE.map((job, i) => (
            <div
              style={`animation-delay:${90 + i * 45}ms`}
              class="anim-lift py-3"
            >
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="data shrink-0 text-ink-soft sm:w-[9.5rem]">{job.period}</span>
                <span class="font-medium">{job.role}</span>
                <span class="leader hidden sm:block" />
                <span class="data shrink-0 text-ink-soft">
                  {job.company} &middot; {job.place}
                </span>
              </div>
              <p class="mt-1 text-step--1 leading-relaxed text-ink-soft sm:ml-[10.5rem]">
                {job.note}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="px-gutter pt-12">
      <RuledHeading href="/works" linkLabel="All">Work</RuledHeading>
      <div class="mt-2">
        {
          works.slice(0, 4).map((entry, i) => (
            <EntryRow
              title={entry.data.title}
              href={entry.data.href}
              stamp={String(entry.data.date.getFullYear())}
              meta={entry.data.role}
              description={entry.data.description}
              stack={entry.data.stack}
              external
              index={i}
            />
          ))
        }
      </div>
    </section>

    <section class="px-gutter pt-12">
      <RuledHeading href="/writings" linkLabel="All">Writing</RuledHeading>
      <div class="mt-2">
        {
          writings.slice(0, 3).map((post, i) => (
            <EntryRow
              title={post.data.title}
              href={`/writings/${post.id}`}
              stamp={monthYear.format(post.data.date)}
              description={post.data.tldr}
              index={i}
            />
          ))
        }
      </div>
    </section>

    <section class="px-gutter pt-12">
      <RuledHeading>Stack</RuledHeading>
      <div class="mt-4">
        <StackList />
      </div>
    </section>
  </Shell>
</Base>
