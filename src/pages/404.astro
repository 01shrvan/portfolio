---
import Layout from "@/layouts/Layout.astro";

const hugeLine = "page not found";
const hugeLoop = `${hugeLine}   ${hugeLine}   ${hugeLine}   ${hugeLine}   ${hugeLine}`;
const ticker =
  "page not found / page not found / page not found / page not found / page not found / page not found /";
---

<Layout
  title="404 - page not found"
  description="this page does not exist. head back to shrvan's portfolio."
  showSidebar={false}
  showNowPlaying={false}
  fullScreen={true}
>
  <section class="nf-page">
    <header class="nf-topbar">
      <a href="/" class="nf-brand">shrvan</a>
      <div class="nf-links">
        <a href="/">home</a>
        <a href="/works">works</a>
        <a href="/writings">writings</a>
      </div>
    </header>

    <div class="nf-rows" aria-hidden="true">
      <p class="nf-row nf-row-left">{hugeLoop}</p>
      <p class="nf-row nf-row-right">{hugeLoop}</p>
      <p class="nf-row nf-row-left">{hugeLoop}</p>
    </div>

    <div class="nf-center-strip" aria-hidden="true">
      <div class="nf-center-track">
        <span>{ticker}</span>
        <span>{ticker}</span>
        <span>{ticker}</span>
      </div>
    </div>

    <div class="nf-actions">
      <a href="/">go home</a>
      <a href="/works">view works</a>
      <a href="/writings">read writings</a>
    </div>
  </section>
</Layout>

<style is:global>
  .nf-page {
    position: relative;
    height: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: hsl(var(--background));
    border: 1px solid hsl(var(--border) / 0.75);
    isolation: isolate;
  }

  .nf-topbar {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0;
  }

  .nf-brand {
    font-family: "Naori", serif;
    font-size: clamp(1.4rem, 4vw, 2rem);
    letter-spacing: 0.02em;
    text-decoration: none;
    color: hsl(var(--foreground));
  }

  .nf-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nf-links a {
    text-decoration: none;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: hsl(var(--muted-foreground));
    transition: color 0.2s ease;
  }

  .nf-links a:hover {
    color: hsl(var(--foreground));
  }

  .nf-rows {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: clamp(0.8rem, 2vw, 1.45rem);
    pointer-events: none;
  }

  .nf-row {
    margin: 0;
    width: max-content;
    white-space: nowrap;
    line-height: 0.9;
    font-weight: 600;
    font-size: clamp(3.3rem, 16vw, 12rem);
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: hsl(var(--foreground) / 0.14);
  }

  .nf-row-left {
    animation: nf-slide-left 12s linear infinite;
  }

  .nf-row-right {
    animation: nf-slide-right 12s linear infinite;
  }

  .nf-center-strip {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    overflow: hidden;
    border-top: 1px solid hsl(var(--border));
    border-bottom: 1px solid hsl(var(--border));
    background: hsl(var(--card));
    z-index: 15;
  }

  .nf-center-track {
    display: flex;
    width: max-content;
    white-space: nowrap;
    padding: 0.48rem 0;
    animation: nf-ticker 9s linear infinite;
    will-change: transform;
  }

  .nf-center-track span {
    padding-right: 2rem;
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    color: hsl(var(--foreground));
  }

  .nf-actions {
    position: absolute;
    z-index: 25;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--background) / 0.86);
    backdrop-filter: blur(6px);
  }

  .nf-actions a {
    text-decoration: none;
    font-size: 0.74rem;
    color: hsl(var(--foreground));
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    transition: background-color 0.2s ease;
  }

  .nf-actions a:hover {
    background: hsl(var(--muted));
  }

  @keyframes nf-slide-left {
    from {
      transform: translateX(-24%);
    }
    to {
      transform: translateX(-69%);
    }
  }

  @keyframes nf-slide-right {
    from {
      transform: translateX(-69%);
    }
    to {
      transform: translateX(-24%);
    }
  }

  @keyframes nf-ticker {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 640px) {
    .nf-topbar {
      padding: 0.75rem 0.75rem 0;
    }

    .nf-links {
      gap: 0.55rem;
    }

    .nf-links a {
      font-size: 0.62rem;
      letter-spacing: 0.1em;
    }

    .nf-actions {
      left: 0.75rem;
      right: 0.75rem;
      transform: none;
      border-radius: 0.9rem;
    }
  }
</style>
