---
import Base from "@/layouts/Base.astro";
import Shell from "@/components/Shell.astro";
import PageHead from "@/components/PageHead.astro";
import RuledHeading from "@/components/RuledHeading.astro";
import SpecTable from "@/components/SpecTable.astro";
import { SITE, SOCIALS } from "@/lib/site";
---

<Base
  title="Connect"
  description="Open to freelance, contract, and full-time work."
>
  <Shell>
    <PageHead
      title="Connect"
      lede="Tell me what you're building and where it's stuck. I read everything and reply to anything with a real project behind it."
    />

    <section class="px-gutter pt-12">
      <RuledHeading>Email</RuledHeading>
      <div class="anim-lift mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        <a href={`mailto:${SITE.email}`} class="link text-step-1">
          {SITE.email}
        </a>
        <button
          type="button"
          data-copy={SITE.email}
          class="data h-7 border border-rule-strong px-2.5 uppercase text-ink-soft transition-colors duration-200 hover:border-filament hover:text-filament"
        >
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <p class="mt-5 max-w-measure text-ink-soft">
        Useful things to include: what the product does, what the stack looks
        like, and the deadline you&rsquo;re actually working to.
      </p>
    </section>

    <section class="px-gutter pt-12">
      <RuledHeading>Details</RuledHeading>
      <div class="mt-4">
        <SpecTable
          rows={[
            {
              label: "Status",
              value: "Open to freelance, contract, and full-time",
              live: true,
            },
            { label: "Timezone", value: "IST (UTC+5:30), Mumbai" },
            { label: "Reply time", value: "Within two working days" },
          ]}
        />
      </div>
    </section>

    <section class="px-gutter pt-12">
      <RuledHeading>Elsewhere</RuledHeading>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
        {
          SOCIALS.map(({ label, href }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="link text-step--1"
            >
              {label}
            </a>
          ))
        }
      </div>
    </section>
  </Shell>
</Base>

<script>
  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLButtonElement>("[data-copy]");
    if (!button) return;

    const label = button.querySelector("[data-copy-label]");
    if (!label) return;

    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      label.textContent = "Copied";
    } catch {
      // Clipboard blocked (insecure context or denied permission). The
      // address is selectable text right beside this control, so say so.
      label.textContent = "Select it";
    }
    setTimeout(() => (label.textContent = "Copy"), 2000);
  });
</script>
