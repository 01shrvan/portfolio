---
import Container from "../components/Container.astro";
import Layout from "../layouts/Layout.astro";
import ConnectLinks from "../components/connect/ConnectLinks";
---

<Layout
  title="connect | shrvan"
  description="get in touch with me via social media or email."
>
  <Container>
    <div class="flex flex-col space-y-12">
      <div class="space-y-4">
        <h1 class="text-2xl font-semibold">connect</h1>
        <p
          class="leading-[150%] tracking-wide text-muted-foreground text-sm md:text-base"
        >
          feel free to reach out to me on any of the platforms below. i'm always
          open to new opportunities and collaborations.
        </p>

        <div class="pt-4">
          <ConnectLinks client:load />
        </div>
      </div>
    </div>
  </Container>
</Layout>
