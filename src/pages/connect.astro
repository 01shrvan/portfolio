---
import Base from "@/layouts/Base.astro";
import Shell from "@/components/Shell.astro";
import PageHead from "@/components/PageHead.astro";
import RuledHeading from "@/components/RuledHeading.astro";
import SpecTable from "@/components/SpecTable.astro";
import { SITE, SOCIALS } from "@/lib/site";
---

<Base
  title="connect"
  description="open to freelance, contract and full-time work."
>
  <Shell>
    <PageHead
      title="connect"
      lede="building something and stuck somewhere? tell me about it. i read everything"
    />

    <section class="px-gutter pt-12">
      <RuledHeading>email</RuledHeading>
      <div class="anim-lift mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        <a href={`mailto:${SITE.email}`} class="link text-step-1">
          {SITE.email}
        </a>
        <button
          type="button"
          data-copy={SITE.email}
          class="data h-7 border border-rule-strong px-2.5 lowercase text-ink-soft transition-colors duration-200 hover:border-filament hover:text-filament"
        >
          <span data-copy-label>copy</span>
        </button>
      </div>
      <p class="mt-5 max-w-measure text-ink-soft">
        useful stuff to include: what it does, what its built on, and the
        deadline youre actually working to
      </p>
    </section>

    <section class="px-gutter pt-12">
      <RuledHeading>details</RuledHeading>
      <div class="mt-4">
        <SpecTable
          rows={[
            {
              label: "status",
              value: "open to freelance, contract and full-time",
              live: true,
            },
            { label: "timezone", value: "ist (utc+5:30), mumbai" },
            { label: "reply time", value: "usually within two days" },
          ]}
        />
      </div>
    </section>

    <section class="px-gutter pt-12">
      <RuledHeading>elsewhere</RuledHeading>
      <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
        {
          SOCIALS.map(({ label, href }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="link text-step--1"
            >
              {label}
            </a>
          ))
        }
      </div>
    </section>
  </Shell>
</Base>

<script>
  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLButtonElement>("[data-copy]");
    if (!button) return;

    const label = button.querySelector("[data-copy-label]");
    if (!label) return;

    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      label.textContent = "copied";
    } catch {
      label.textContent = "select it";
    }
    setTimeout(() => (label.textContent = "copy"), 2000);
  });
</script>
