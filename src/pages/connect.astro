---
import Layout from "../layouts/Layout.astro";
import ConnectLinks from "../components/connect/ConnectLinks";
---

<Layout
  title="connect | shrvan"
  description="get in touch with me via social media or email."
>
  <div class="px-5 py-10">
    <div class="space-y-3">
      <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-muted-foreground/50">
        get in touch
      </span>
      <h1 class="text-xl font-semibold tracking-tight">connect</h1>
      <p class="text-muted-foreground text-sm max-w-sm leading-relaxed">
        feel free to reach out. always open to new things.
      </p>
    </div>

    <div class="mt-8">
      <ConnectLinks client:load />
    </div>
  </div>
</Layout>
