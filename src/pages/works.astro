---
import Layout from "../layouts/Layout.astro";
import WorksList from "../components/works/WorksList";
import { basehub } from "../lib/basehub";

const {
  works: { items: works },
} = await basehub.query({
  works: {
    __args: { orderBy: "_sys_createdAt__DESC" },
    items: {
      _title: true,
      role: true,
      description: true,
      href: true,
      _id: true,
    },
  },
});
---

<Layout
  title="works | shrvan"
  description="stuff i've built, broke, fixed, and somehow shipped anyway"
>
  <div class="px-5 py-10">
    <div class="space-y-3">
      <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-muted-foreground/50">
        selected works
      </span>
      <h1 class="text-xl font-semibold tracking-tight">works</h1>
      <p class="text-muted-foreground text-sm max-w-sm leading-relaxed">
        stuff i've built, broke, fixed, and somehow shipped anyway.
      </p>
    </div>

    <div class="mt-8">
      <WorksList works={works as any} client:load />
    </div>
  </div>
</Layout>
