---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Shell from "@/components/Shell.astro";
import PageHead from "@/components/PageHead.astro";
import RuledHeading from "@/components/RuledHeading.astro";
import EntryRow from "@/components/EntryRow.astro";

const works = (await getCollection("works")).sort(
  (a, b) => a.data.order - b.data.order,
);
const hasDetail = (w: { body?: string; data: { verify: unknown[]; numbers: unknown[]; counter?: unknown } }) =>
  Boolean(w.body?.trim()) ||
  w.data.verify.length > 0 ||
  w.data.numbers.length > 0 ||
  Boolean(w.data.counter);
---

<Base
  title="works"
  description="products and experiments i've built. most are live, some are just repos."
>
  <Shell>
    <PageHead
      title="works"
      lede="products and experiments i've built. most are live, some are just repos"
    />

    <section class="px-gutter pt-12">
      <RuledHeading count={works.length}>all</RuledHeading>
      <div class="mt-2">
        {
          works.map((entry, i) => (
            <EntryRow
              title={entry.data.title}
              href={hasDetail(entry) ? `/works/${entry.id}` : entry.data.href}
              stamp={String(entry.data.date.getFullYear())}
              meta={entry.data.role}
              description={entry.data.description}
              external={!hasDetail(entry)}
              index={i}
            />
          ))
        }
      </div>
    </section>
  </Shell>
</Base>
