---
import Container from "../components/Container.astro";
import Layout from "../layouts/Layout.astro";
import WorksList from "../components/works/WorksList";
import { basehub } from "../lib/basehub";

const {
  works: { items: works },
} = await basehub.query({
  works: {
    __args: { orderBy: "_sys_createdAt__DESC" },
    items: {
      _title: true,
      role: true,
      description: true,
      href: true,
      _id: true,
    },
  },
});
---

<Layout
  title="works | shrvan"
  description="stuff i've built, broke, fixed, and somehow shipped anyway"
>
  <Container>
    <div class="flex flex-col space-y-12">
      <div class="space-y-4">
        <h1 class="text-2xl font-semibold">works</h1>
        <p
          class="leading-[150%] tracking-wide text-muted-foreground text-sm md:text-base"
        >
          stuff i've built, broke, fixed, and somehow shipped anyway. from
          side projects that went somewhere to experiments that taught me
          something
        </p>

        <div>
          <WorksList works={works} client:load />
        </div>
      </div>
    </div>
  </Container>
</Layout>