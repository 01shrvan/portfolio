---
import Layout from "../layouts/Layout.astro";
import { basehub } from "../lib/basehub";

const {
  writings: { items: writings },
} = await basehub.query({
  writings: {
    __args: { orderBy: "_sys_createdAt__DESC" },
    items: {
      _title: true,
      _slug: true,
      _sys: { createdAt: true },
    },
  },
});
---

<Layout
  title="writings | shrvan"
  description="random thoughts, cool finds, and things i probably should've kept to myself but didn't"
>
  <div class="px-5 py-10 space-y-8">
    <div class="space-y-2">
      <span class="font-mono text-[9px] uppercase tracking-[0.25em] text-muted-foreground/50">
        thoughts & notes
      </span>
      <h1 class="text-xl font-semibold tracking-tight">writings</h1>
      <p class="text-muted-foreground text-sm max-w-sm leading-relaxed">
        random thoughts, cool finds, and things i probably should've kept to
        myself but didn't.
      </p>
    </div>

    <ul class="flex flex-col">
      {
        writings.map((writing) => (
          <li class="group border-t border-border last:border-b">
            <a
              href={`/writings/${writing._slug}`}
              class="relative flex items-center justify-between px-4 py-4 transition-colors duration-200 group-hover:bg-muted/20 overflow-hidden"
            >
              <span class="absolute h-2.5 w-2.5 border-foreground/[0.1] group-hover:border-foreground/40 border-t border-l top-0 left-0 transition-colors duration-300" />
              <span class="absolute h-2.5 w-2.5 border-foreground/[0.1] group-hover:border-foreground/40 border-t border-r top-0 right-0 transition-colors duration-300" />
              <span class="absolute h-2.5 w-2.5 border-foreground/[0.1] group-hover:border-foreground/40 border-b border-l bottom-0 left-0 transition-colors duration-300" />
              <span class="absolute h-2.5 w-2.5 border-foreground/[0.1] group-hover:border-foreground/40 border-b border-r bottom-0 right-0 transition-colors duration-300" />

              <span class="shine absolute -top-1/2 h-[200%] w-1/2 skew-x-[-20deg] bg-gradient-to-r from-transparent via-white/[0.06] to-transparent pointer-events-none" />

              <p class="font-medium text-sm truncate max-w-[65%] z-10">
                {writing._title}
              </p>

              <div class="flex items-center gap-3 shrink-0 z-10">
                <span class="font-mono text-[9px] text-muted-foreground/60">
                  {new Date(writing._sys.createdAt).toLocaleDateString("en-GB")}
                </span>
                <span class="overflow-hidden w-0 opacity-0 group-hover:w-4 group-hover:opacity-100 transition-all duration-200 text-muted-foreground font-mono text-xs">
                  →
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
