---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import "@/styles/app.css";
import { SITE } from "@/lib/site";

export const getStaticPaths = (async () => {
  const works = await getCollection("works");
  const writings = await getCollection("writings");

  const cards = [
    {
      slug: "home",
      kicker: SITE.aka,
      title: SITE.name.toLowerCase(),
      lede: "full-stack engineer from mumbai, mostly living on the frontend",
      stat: null as string | null,
    },
    ...works.map((w) => ({
      slug: `works-${w.id}`,
      kicker: "works",
      title: w.data.title,
      lede: w.data.description,
      stat: w.data.numbers[0]
        ? `${w.data.numbers[0].value} ${w.data.numbers[0].label}`
        : null,
    })),
    ...writings
      .filter((p) => !p.data.draft)
      .map((p) => ({
        slug: `writings-${p.id}`,
        kicker: "writings",
        title: p.data.title,
        lede: p.data.tldr,
        stat: null as string | null,
      })),
  ];

  return cards.map((card) => ({ params: { slug: card.slug }, props: { card } }));
}) satisfies GetStaticPaths;

const { card } = Astro.props;
const lede = card.lede.length > 150 ? `${card.lede.slice(0, 147)}...` : card.lede;
const titleSize = card.title.length > 26 ? "56px" : "78px";
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>og card</title>
    <style>
      html,
      body {
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
    </style>
  </head>
  <body class="grain">
    <div class="flex h-[630px] w-[1200px] items-stretch px-[92px] py-[1px]">
      <div class="flex w-full flex-col border-x">
        <div
          class="data flex items-center justify-between border-b px-10 py-6 lowercase text-ink-soft"
        >
          <span>{card.kicker}</span>
          <span>shrvan.xyz</span>
        </div>

        <div class="flex flex-1 items-center justify-between gap-12 px-10">
          <div class="min-w-0">
            <h1
              class="display leading-[1.04] tracking-[-0.028em]"
              style={`font-size:${titleSize}`}
            >
              {card.title}
            </h1>
            <p class="mt-6 max-w-[42ch] text-[22px] leading-[1.5] text-ink-soft">
              {lede}
            </p>
            {
              card.stat && (
                <p class="data mt-7 inline-block border px-3 py-2 lowercase text-filament text-[20px]">
                  {card.stat}
                </p>
              )
            }
          </div>

          <div
            class="relative size-[190px] shrink-0 overflow-hidden border border-rule-strong"
          >
            <div class="og-plate absolute inset-0"></div>
          </div>
        </div>

        <div
          class="data flex items-center justify-between border-t px-10 py-6 lowercase text-ink-soft"
        >
          <span>shrvan benke &middot; @{SITE.aka}</span>
          <span>github.com/01shrvan</span>
        </div>
      </div>
    </div>

    <style>
      .og-plate {
        background-image: radial-gradient(
          circle,
          var(--color-filament) 1.5px,
          transparent 1.6px
        );
        background-size: 8px 8px;
        mask-image: radial-gradient(
          circle at 50% 50%,
          #000 6%,
          rgba(0, 0, 0, 0.85) 26%,
          rgba(0, 0, 0, 0.35) 44%,
          transparent 62%
        );
      }
    </style>
  </body>
</html>
