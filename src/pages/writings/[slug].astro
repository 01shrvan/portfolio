---
import Layout from "../../layouts/Layout.astro";
import { basehub } from "../../lib/basehub";

export async function getStaticPaths() {
  const {
    writings: { items: writings },
  } = await basehub.query({
    writings: {
      items: {
        _slug: true,
      },
    },
  });

  return writings.map((writing) => {
    return {
      params: {
        slug: writing._slug,
      },
    };
  });
}

const { slug } = Astro.params;

const {
  writings: { items: writings },
} = await basehub.query({
  writings: {
    __args: {
      filter: {
        _slug: { eq: slug },
      },
      first: 1,
    },
    items: {
      _title: true,
      tldr: true,
      _sys: {
        createdAt: true,
      },
      content: {
        html: true,
      },
    },
  },
});

const writing = writings[0];

if (!writing) {
  return Astro.redirect("/404");
}

const createdAt = new Date(writing._sys.createdAt).toLocaleString("en-US", {
  year: "numeric",
  month: "short",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hourCycle: "h23",
  timeZoneName: "shortOffset",
  timeZone: "Asia/Kolkata",
});
---

<Layout title={`${writing._title} | shrvan`} description={writing._title}>
  <div class="px-5 py-10 space-y-10 max-w-2xl">
    <header class="space-y-4">
      <a
        href="/writings"
        class="inline-flex items-center gap-1.5 font-mono text-[9px] uppercase tracking-[0.25em] text-muted-foreground hover:text-foreground transition-colors duration-200"
      >
        ← writings
      </a>
      <div class="space-y-2">
        <h1 class="text-xl font-semibold leading-snug">{writing._title}</h1>
        <div class="flex items-center gap-2 font-mono text-[10px] text-muted-foreground">
          <span>shrvan</span>
          <span>·</span>
          <span>{createdAt}</span>
        </div>
      </div>
    </header>

    <section class="space-y-8 text-sm">
      {
        writing.tldr && (
          <blockquote class="border-l-2 border-border pl-4 space-y-1">
            <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-muted-foreground">tl;dr</p>
            <p class="text-muted-foreground italic">"{writing.tldr}"</p>
          </blockquote>
        )
      }
      <div
        class="prose prose-invert prose-sm max-w-none prose-p:text-muted-foreground prose-headings:text-foreground prose-a:text-foreground prose-strong:text-foreground"
        set:html={writing.content.html}
      />
    </section>
  </div>
</Layout>
