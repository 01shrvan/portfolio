---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Shell from "@/components/Shell.astro";
import PageHead from "@/components/PageHead.astro";
import RuledHeading from "@/components/RuledHeading.astro";
import EntryRow from "@/components/EntryRow.astro";

const posts = (await getCollection("writings"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const monthYear = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
});
---

<Base
  title="writings"
  description="notes and devlogs on things i learn and break."
>
  <Shell>
    <PageHead
      title="writings"
      lede="notes and devlogs on things i learn and break"
    />

    <section class="px-gutter pt-12">
      <RuledHeading count={posts.length}>all</RuledHeading>
      <div class="mt-2">
        {
          posts.map((post, i) => (
            <EntryRow
              title={post.data.title}
              href={`/writings/${post.id}`}
              stamp={monthYear.format(post.data.date)}
              description={post.data.tldr}
              index={i}
            />
          ))
        }
      </div>
    </section>
  </Shell>
</Base>
