---
/* The social card, rendered as a real page so it inherits the site's own
   fonts and tokens. `npm run og` screenshots it to public/og.png. It is
   excluded from the sitemap and marked noindex — it exists to be captured,
   not to be visited. */
import "@/styles/app.css";
import { SITE } from "@/lib/site";
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>og card</title>
    <style>
      html,
      body {
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
    </style>
  </head>
  <body class="grain">
    <div class="flex h-[630px] w-[1200px] items-stretch px-[92px] py-[1px]">
      <div class="flex w-full flex-col border-x">
        <div class="data flex items-center justify-between border-b px-10 py-6 uppercase text-ink-soft">
          <span>{SITE.aka}</span>
          <span>shrvan.xyz</span>
        </div>

        <div class="flex flex-1 items-center justify-between gap-12 px-10">
          <div>
            <h1 class="display text-[78px] leading-[1.02] tracking-[-0.028em]">
              {SITE.name}
            </h1>
            <p class="mt-3.5 text-[30px] text-filament">
              {SITE.role}, Mumbai
            </p>
            <p class="mt-6 max-w-[30ch] text-[22px] leading-[1.5] text-ink-soft">
              i build web apps end to end — and care how they feel, not just
              whether they work.
            </p>
          </div>

          <div class="relative size-[190px] shrink-0 overflow-hidden border border-rule-strong">
            <div class="og-plate absolute inset-0"></div>
          </div>
        </div>

        <div class="data flex items-center justify-between border-t px-10 py-6 uppercase text-ink-soft">
          <span>Works · Writing · Connect</span>
          <span>github.com/01shrvan</span>
        </div>
      </div>
    </div>

    <style>
      /* A static halftone: even dots, with a radial mask so density alone
         reads as a sphere — the same logic as the live Fig. 1 plate. */
      .og-plate {
        background-image: radial-gradient(
          circle,
          var(--color-filament) 1.5px,
          transparent 1.6px
        );
        background-size: 8px 8px;
        mask-image: radial-gradient(
          circle at 50% 50%,
          #000 6%,
          rgba(0, 0, 0, 0.85) 26%,
          rgba(0, 0, 0, 0.35) 44%,
          transparent 62%
        );
      }
    </style>
  </body>
</html>
